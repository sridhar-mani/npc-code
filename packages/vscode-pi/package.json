{
	"name": "ziq-vscode-pi",
	"displayName": "Pi Coding Assistant",
	"description": "Pi coding agent for Visual Studio Code",
	"version": "0.1.0",
	"publisher": "zenteiq",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"ai",
		"pi",
		"assistant",
		"ollama",
		"byom",
		"coding-agent"
	],
	"icon": "assets/icon.png",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "pi-assistant",
					"title": "Pi Assistant",
					"icon": "assets/pi-sidebar.svg"
				}
			]
		},
		"views": {
			"pi-assistant": [
				{
					"type": "webview",
					"id": "pi-assistant.dashboard",
					"name": "Pi Assistant"
				}
			]
		},
		"commands": [
			{
				"command": "pi.openChat",
				"title": "Pi: Open Chat",
				"category": "Pi",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "pi.addCustomModel",
				"title": "Pi: Add Custom Model",
				"category": "Pi",
				"icon": "$(add)"
			},
			{
				"command": "pi.selectActiveModel",
				"title": "Pi: Select Active Model",
				"category": "Pi",
				"icon": "$(sparkle)"
			},
			{
				"command": "pi.syncOllamaModels",
				"title": "Pi: Sync Ollama Models",
				"category": "Pi",
				"icon": "$(sync)"
			},
			{
				"command": "pi.openTerminalAgent",
				"title": "Pi: Open Terminal Agent",
				"category": "Pi",
				"icon": "$(terminal)"
			},
			{
				"command": "pi.openSettings",
				"title": "Pi: Configure Models & Settings",
				"category": "Pi",
				"icon": "$(gear)"
			}
		],
		"chatParticipants": [
			{
				"id": "pi.chat",
				"name": "pi",
				"fullName": "Pi Assistant",
				"description": "Pi Coding Assistant"
			}
		],
		"configuration": {
			"title": "Pi Coding Assistant",
			"properties": {
				"pi.ollama.url": {
					"type": "string",
					"default": "http://127.0.0.1:11434",
					"description": "Base URL of the local or remote Ollama server instance."
				},
				"pi.models.default": {
					"type": "string",
					"default": "",
					"description": "Default active model ID for Pi."
				},
				"pi.runtime.autoSyncOllama": {
					"type": "boolean",
					"default": true,
					"description": "Automatically discover and synchronize local Ollama models on startup."
				},
				"pi.runtime.allowNetwork": {
					"type": "boolean",
					"default": true,
					"description": "Allow Pi to make network requests to external provider APIs."
				},
				"pi.runtime.timeout": {
					"type": "number",
					"default": 60000,
					"description": "HTTP request timeout in milliseconds for model provider completions."
				},
				"pi.terminalCommand": {
					"type": "string",
					"default": "pi",
					"description": "Command used to launch the Pi terminal agent."
				}
			}
		}
	},
	"scripts": {
		"build": "node esbuild.ts",
		"compile": "node esbuild.ts --dev",
		"package": "vsce package --no-dependencies"
	},
	"dependencies": {
		"@earendil-works/pi-core": "^0.87.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "^3.6.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.8.0"
	}
}
