{
	"name": "ziq-vscode-ui",
	"displayName": "Ziq Coding Assistant",
	"description": "Enterprise AI Coding Assistant powered by Pi and Zenteiq",
	"version": "0.44.3",
	"publisher": "zenteiq",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"ai",
		"pi",
		"assistant",
		"ollama",
		"byom",
		"deepseek",
		"agent"
	],
	"icon": "assets/logo.png",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onView:pi-assistant-sidebar",
		"onView:pi-assistant-welcome",
		"onCommand:pi.openChat",
		"onCommand:pi.addCustomModel",
		"onCommand:pi.selectActiveModel",
		"onCommand:pi.syncOllamaModels",
		"onCommand:pi.openTerminalAgent",
		"onChatParticipant:pi.chat"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "pi-assistant-container",
					"title": "Ziq Assistant",
					"icon": "assets/logo.png"
				}
			]
		},
		"views": {
			"pi-assistant-container": [
				{
					"type": "webview",
					"id": "pi-assistant-sidebar",
					"name": "Ziq Chat"
				},
				{
					"id": "pi-assistant-welcome",
					"name": "Models & Quick Actions"
				}
			]
		},
		"commands": [
			{
				"command": "pi.openChat",
				"title": "Open Ziq Chat",
				"category": "Ziq",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "pi.addCustomModel",
				"title": "Add Custom Model (BYOM)",
				"category": "Ziq",
				"icon": "$(add)"
			},
			{
				"command": "pi.selectActiveModel",
				"title": "Select Active Model",
				"category": "Ziq",
				"icon": "$(sparkle)"
			},
			{
				"command": "pi.syncOllamaModels",
				"title": "Sync Ollama Models",
				"category": "Ziq",
				"icon": "$(sync)"
			},
			{
				"command": "pi.openTerminalAgent",
				"title": "Launch Terminal Agent",
				"category": "Ziq",
				"icon": "$(terminal)"
			}
		],
		"chatParticipants": [
			{
				"id": "pi.chat",
				"name": "ziq",
				"fullName": "Ziq Assistant",
				"description": "Enterprise AI coding companion powered by Zenteiq",
				"isDefault": true
			}
		],
		"configuration": {
			"title": "Ziq Assistant",
			"properties": {
				"pi.activeModel": {
					"type": "string",
					"default": "",
					"description": "The active model identifier used for Ziq chat and completions (e.g. 'llama3.2', 'deepseek-chat')."
				},
				"pi.ollamaUrl": {
					"type": "string",
					"default": "http://127.0.0.1:11434",
					"description": "Base URL of the local Ollama instance."
				},
				"pi.autoSyncOllama": {
					"type": "boolean",
					"default": true,
					"description": "Automatically detect and sync models from local Ollama on startup."
				},
				"pi.customModels": {
					"type": "array",
					"default": [],
					"description": "Custom OpenAI-compatible / BYOM model definitions.",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"description": "Unique model ID"
							},
							"name": {
								"type": "string",
								"description": "Display name"
							},
							"baseUrl": {
								"type": "string",
								"description": "API Base URL"
							},
							"apiKey": {
								"type": "string",
								"description": "API Key (optional if using local gateway)"
							}
						},
						"required": [
							"id",
							"name",
							"baseUrl"
						]
					}
				},
				"pi.terminalCommand": {
					"type": "string",
					"default": "pi",
					"description": "Command used to launch the Ziq terminal agent."
				}
			}
		},
		"menus": {
			"view/title": [
				{
					"command": "pi.addCustomModel",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@1"
				},
				{
					"command": "pi.selectActiveModel",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@2"
				},
				{
					"command": "pi.syncOllamaModels",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@3"
				},
				{
					"command": "pi.refreshSidebar",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@4"
				}
			]
		}
	},
	"scripts": {
		"build": "node .esbuild.ts",
		"compile": "node .esbuild.ts --dev",
		"package": "vsce package",
		"typecheck": "tsc --noEmit -p tsconfig.extension.json",
		"test": "node --test test/extension-contract.test.mjs"
	},
	"devDependencies": {
		"@types/vscode": "1.90.0",
		"@vscode/vsce": "3.6.0",
		"esbuild": "0.28.2",
		"typescript": "5.8.3"
	},
	"dependencies": {
		"@earendil-works/pi-core": "0.87.1",
		"@vscode/codicons": "0.0.46-24",
		"@vscode/webview-ui-toolkit": "1.4.0",
		"typebox": "1.3.27",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"@radix-ui/react-popover": "^1.1.0"
	}
}
