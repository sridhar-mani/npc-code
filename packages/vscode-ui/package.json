{
	"name": "ziq-vscode-ui",
	"displayName": "Ziq Coding Assistant",
	"description": "Enterprise AI Coding Assistant powered by Pi and Zenteiq",
	"version": "0.44.5",
	"publisher": "zenteiq",
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"ai",
		"pi",
		"assistant",
		"ollama",
		"byom",
		"deepseek",
		"agent"
	],
	"icon": "assets/logo.png",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onView:pi-assistant-sidebar",
		"onView:pi-assistant-welcome",
		"onCommand:pi.openChat",
		"onCommand:pi.addCustomModel",
		"onCommand:pi.selectActiveModel",
		"onCommand:pi.syncOllamaModels",
		"onCommand:pi.openTerminalAgent",
		"onChatParticipant:pi.chat"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "pi-assistant-container",
					"title": "Ziq Assistant",
					"icon": "assets/ziq.svg"
				}
			]
		},
		"views": {
			"pi-assistant-container": [
				{
					"type": "webview",
					"id": "pi-assistant-sidebar",
					"name": "Ziq Chat"
				},
				{
					"id": "pi-assistant-welcome",
					"name": "Models & Quick Actions"
				}
			]
		},
		"commands": [
			{
				"command": "pi.openChat",
				"title": "Open Ziq Chat",
				"category": "Ziq",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "pi.addCustomModel",
				"title": "Add Custom Model (BYOM)",
				"category": "Ziq",
				"icon": "$(add)"
			},
			{
				"command": "pi.selectActiveModel",
				"title": "Select Active Model",
				"category": "Ziq",
				"icon": "$(sparkle)"
			},
			{
				"command": "pi.syncOllamaModels",
				"title": "Sync Ollama Models",
				"category": "Ziq",
				"icon": "$(sync)"
			},
			{
				"command": "pi.openTerminalAgent",
				"title": "Launch Terminal Agent",
				"category": "Ziq",
				"icon": "$(terminal)"
			},
			{
				"command": "pi.configureSwitchyardModels",
				"title": "Configure Switchyard Models",
				"category": "Ziq",
				"icon": "$(server-environment)"
			},
			{
				"command": "pi.showLogs",
				"title": "Show Pi Diagnostic Logs",
				"category": "Ziq",
				"icon": "$(output)"
			}
		],
		"chatParticipants": [
			{
				"id": "pi.chat",
				"name": "ziq",
				"fullName": "Ziq Assistant",
				"description": "Enterprise AI coding companion powered by Zenteiq",
				"isDefault": true
			}
		],
		"configuration": {
			"title": "Ziq Assistant",
			"properties": {
				"pi.activeModel": {
					"type": "string",
					"default": "",
					"description": "The active model identifier used for Ziq chat and completions (e.g. 'llama3.2', 'deepseek-chat')."
				},
				"pi.ollamaUrl": {
					"type": "string",
					"default": "http://127.0.0.1:11434",
					"description": "Base URL of the local Ollama instance."
				},
				"pi.autoSyncOllama": {
					"type": "boolean",
					"default": true,
					"description": "Automatically detect and sync models from local Ollama on startup."
				},
				"pi.customModels": {
					"type": "array",
					"default": [],
					"description": "Custom OpenAI-compatible / BYOM model definitions.",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"description": "Unique model ID"
							},
							"name": {
								"type": "string",
								"description": "Display name"
							},
							"baseUrl": {
								"type": "string",
								"description": "API Base URL"
							},
							"apiKey": {
								"type": "string",
								"description": "API Key (optional if using local gateway)"
							},
							"label": {
								"type": "string",
								"description": "Display label used by the Pi model picker"
							},
							"thinking": {
								"type": "boolean",
								"description": "Whether the model supports reasoning/thinking"
							},
							"reasoning": {
								"type": "boolean",
								"description": "Reasoning capability flag"
							},
							"contextWindow": {
								"type": "number",
								"description": "Context window in tokens"
							},
							"maxOutputTokens": {
								"type": "number",
								"description": "Maximum output tokens"
							},
							"toolCalling": {
								"type": "boolean",
								"description": "Whether tools are supported"
							},
							"vision": {
								"type": "boolean",
								"description": "Whether image input is supported"
							},
							"api": {
								"type": "string",
								"description": "Pi model API adapter identifier"
							},
							"isOllama": {
								"type": "boolean",
								"description": "Marks a model discovered from the configured Ollama instance"
							}
						},
						"required": [
							"id",
							"name",
							"baseUrl"
						]
					}
				},
				"pi.terminalCommand": {
					"type": "string",
					"default": "pi",
					"description": "Command used to launch the Ziq terminal agent."
				},
				"pi.agentFeatures.guardrails.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable Pi guardrail permission checks before tool execution."
				},
				"pi.agentFeatures.guardrails.hooksEnabled": {
					"type": "boolean",
					"default": false,
					"description": "Run PreToolUse/PostToolUse declarative hooks when guardrails are enabled."
				},
				"pi.agentFeatures.guardrails.defaultTier": {
					"type": "string",
					"enum": [
						"ask_every_time",
						"config",
						"allow",
						"ask",
						"deny"
					],
					"enumDescriptions": [
						"Prompt before every guarded tool call; approval grants that call only.",
						"Respect .pi/.ziq guardrail configuration.",
						"Allow by default unless a specific rule blocks the action.",
						"Ask when the policy requires approval; non-interactive clients fail closed.",
						"Hard deny unless a specific rule produces an approval path; this does not prompt."
					],
					"default": "ask_every_time",
					"description": "Interactive default: deny until the user explicitly approves each guarded tool call."
				},
				"pi.agentFeatures.switchyard.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Enable the Switchyard capability-aware virtual model."
				},
				"pi.agentFeatures.switchyard.efficientModel": {
					"type": "string",
					"default": "",
					"description": "Efficient model reference. Use 'Ziq: Configure Switchyard Models' to choose from the current active provider."
				},
				"pi.agentFeatures.switchyard.capableModel": {
					"type": "string",
					"default": "",
					"description": "Capable model reference used for escalation; configure from the current provider with 'Ziq: Configure Switchyard Models'."
				},
				"pi.agentFeatures.switchyard.evaluatorModel": {
					"type": "string",
					"default": "",
					"description": "Optional Switchyard evaluator model reference."
				},
				"pi.agentFeatures.switchyard.picker": {
					"type": "string",
					"enum": [
						"efficient_first",
						"capable_first"
					],
					"default": "efficient_first",
					"description": "Routing bias when Switchyard scores a request."
				},
				"pi.agentFeatures.personalization.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Inject saved project/developer conventions into Pi prompts."
				},
				"pi.agentFeatures.personalization.autoLearn": {
					"type": "boolean",
					"default": false,
					"description": "Persist explicit Always/Never/Prefer conventions from user prompts."
				},
				"pi.agentFeatures.personalization.maxTokens": {
					"type": "number",
					"default": 1200,
					"minimum": 200,
					"maximum": 8000,
					"description": "Approximate token budget for injected conventions."
				},
				"pi.agentFeatures.semble.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Enable the syntax-aware Semble code search tool in the agent tool loadout."
				},
				"pi.agentFeatures.semble.maxResults": {
					"type": "number",
					"default": 8,
					"minimum": 1,
					"maximum": 50,
					"description": "Default maximum Semble results. The tool may still receive an explicit per-call limit."
				},
				"pi.agentFeatures.worktree.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Experimental: isolate session file edits in a Git worktree. Cleanup is configurable; merge/reconciliation remains an explicit workflow."
				},
				"pi.agentFeatures.worktree.rootDir": {
					"type": "string",
					"default": "",
					"description": "Optional root directory reserved for future isolated session worktrees."
				},
				"pi.agentFeatures.worktree.cleanupOnDispose": {
					"type": "boolean",
					"default": false,
					"description": "Experimental cleanup preference for future worktree lifecycle integration."
				}
			}
		},
		"menus": {
			"view/title": [
				{
					"command": "pi.addCustomModel",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@1"
				},
				{
					"command": "pi.selectActiveModel",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@2"
				},
				{
					"command": "pi.syncOllamaModels",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@3"
				},
				{
					"command": "pi.refreshSidebar",
					"when": "view == pi-assistant-welcome",
					"group": "navigation@4"
				}
			]
		}
	},
	"scripts": {
		"build": "node .esbuild.ts",
		"compile": "node .esbuild.ts --dev",
		"package": "vsce package",
		"typecheck": "tsc --noEmit -p tsconfig.extension.json",
		"test": "node --test test/extension-contract.test.mjs"
	},
	"devDependencies": {
		"@types/react": "18.3.18",
		"@types/react-dom": "18.3.5",
		"@types/vscode": "1.90.0",
		"@vscode/vsce": "3.6.0",
		"esbuild": "0.28.2",
		"typescript": "5.8.3"
	},
	"dependencies": {
		"@earendil-works/chord": "0.87.1",
		"@earendil-works/pi-agent-core": "0.87.1",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-core": "0.87.1",
		"@earendil-works/pi-server": "0.87.1",
		"@radix-ui/react-collapsible": "1.1.20",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"@vscode/codicons": "0.0.46-24",
		"@vscode/webview-ui-toolkit": "1.4.0",
		"marked": "18.0.11",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typebox": "1.3.27",
		"@earendil-works/pi-client": "0.87.1"
	}
}
